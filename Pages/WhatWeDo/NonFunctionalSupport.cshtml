                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Business plan</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Business expansion plan</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Business turnaround plan</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Productivity improvement plan</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Accounting / Bookkeeping</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Preparation of budgets</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Setting up debtors / creditors system</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Setting up a Stock Control System</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Costing & Pricing</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Cash Flow Management System</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Electronic Financial Management System</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Manual Financial Management System</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-info me-2"></i>Marketing plan & strategy</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Marketing Support -->
            <div class="mb-4">
                <h5 class="text-info"><i class="fas fa-bullhorn me-2"></i>Marketing Support</h5>
