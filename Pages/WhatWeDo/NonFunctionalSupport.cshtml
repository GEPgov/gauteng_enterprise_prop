            <p class="lead mb-4">Visit one of our regional offices or contact us today</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="tel:0870572000" class="btn btn-light btn-lg">
                    <i class="fas fa-phone me-2"></i>Call 087 057 2000
                </a>
                <a href="mailto:enquiries@gep.co.za" class="btn btn-outline-light btn-lg">
