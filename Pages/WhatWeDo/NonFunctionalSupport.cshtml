                            <li>Business cards</li>
                            <li>Brochures & pamphlets</li>
                            <li>Catalogues</li>
                            <li>Magnetic car stickers</li>
                            <li>Sign boards & street pole ads</li>
                            <li>Document folders & letterheads</li>
                            <li>Product labels</li>
