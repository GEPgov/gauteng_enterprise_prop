@page
@model Gauteng_Enterprise_Propeller.Pages.WhatWeDo.NonFunctionalSupportModel
@{
    ViewData["Title"] = "Non-Financial Support";
}

<div class="page-header bg-success text-white py-5">
    <div class="container">
        <h1 class="display-4">Non-Financial Support</h1>
        <p class="lead">Transforming SMMEs, Co-operatives and Informal Traders towards sustainability</p>
    </div>
</div>

<div class="container py-5">
    <!-- Introduction Section -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body">
            <p class="lead">Gauteng Enterprise Propeller provides business development support interventions that play a catalytic role in transforming SMMEs, Co-operatives and Informal Traders towards being sustainable businesses.</p>
            <p>The Non-Financial support program is offered through the Regional Offices and includes:</p>
        </div>
    </div>

    <!-- Key Focus Areas -->
    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="fas fa-city fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Township Economies</h5>
                    <p class="card-text">Gauteng's revitalised township economies contributing to shared economic growth and development</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="fas fa-industry fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Mainstream Economy</h5>
                    <p class="card-text">Gauteng's SMMEs and Co-operatives actively participating in the province's mainstream economy, including key economic sectors</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="fas fa-project-diagram fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Strategic Projects</h5>
                    <p class="card-text">Township Economies Revitalisation (TER) and Gauteng Informal Business Upliftment Strategy (GIBUS) effectively implemented</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Training Programmes Section -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-graduation-cap me-2"></i>Non-Financial Support Programmes</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title text-primary"><i class="fas fa-certificate me-2"></i>Accredited Training</h6>
                            <p class="card-text small">Offered by accredited training providers</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title text-primary"><i class="fas fa-chalkboard-teacher me-2"></i>In-house Training</h6>
                            <p class="card-text small">Workshops offered by GEP officials</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title text-primary"><i class="fas fa-handshake me-2"></i>Corporate Partners Training</h6>
                            <p class="card-text small">Offered through strategic partnerships</p>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <h5 class="text-primary mb-3">Our Training Interventions Include:</h5>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <i class="fas fa-users text-success me-2"></i>Cooperatives Governance
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-file-alt text-success me-2"></i>Business Plan Development
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-tags text-success me-2"></i>Pricing and Costing
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-chart-line text-success me-2"></i>Sales and Marketing
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-briefcase text-success me-2"></i>Business Management Skills
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-calculator text-success me-2"></i>Bookkeeping Skills
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-money-bill-wave text-success me-2"></i>Financial Literacy Skills
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-file-contract text-success me-2"></i>Tendering Skills
                </div>
                <div class="col-md-3 mb-2">
                    <i class="fas fa-lightbulb text-success me-2"></i>Entrepreneurship Skills
                </div>
            </div>
        </div>
    </div>

